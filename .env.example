# Optional LLM-assisted evaluation only. Never commit real credentials.
NVIDIA_LLM_MODEL=
# Use the Chat Completions endpoint, not the build.nvidia.com model-card page.
NVIDIA_URL_REFERENCE_MODEL=https://integrate.api.nvidia.com/v1/chat/completions
NVIDIA_API_KEY=

# Paid fallback, used only when explicitly enabled and NVIDIA fails.
OPENROUTER_LLM_MODEL=
OPENROUTER_API_KEY=
OPENROUTER_URL=https://openrouter.ai/api/v1/chat/completions
